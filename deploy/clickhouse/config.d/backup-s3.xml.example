<!-- Example: an S3-compatible target for BACKUP, as a named collection whose secrets come from the environment of
     the ClickHouse container (never write keys into this file). Copy to config.d/backup-s3.xml, mount it next to
     vulture.xml and pass BACKUP_S3_KEY_ID / BACKUP_S3_SECRET to the container. Then:
         BACKUP DATABASE vulture TO S3(vulture_backup_s3, 'daily/2026-01-01.zip');
     Placeholders only: ENDPOINT and BUCKET stand for your provider's endpoint and your bucket.
     The S3 variant is documented in BACKUP.md but was not exercised against a real object store. -->
<clickhouse>
    <named_collections>
        <vulture_backup_s3>
            <url>https://ENDPOINT/BUCKET/vulture/</url>
            <access_key_id from_env="BACKUP_S3_KEY_ID"/>
            <secret_access_key from_env="BACKUP_S3_SECRET"/>
        </vulture_backup_s3>
    </named_collections>
</clickhouse>
