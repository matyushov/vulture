# Template for deploy/.env (copy it: `cp .env.example .env`). The real .env is ignored by git; never commit it.
# Compose reads it for interpolation: `docker compose --env-file .env up -d` (or keep it next to the compose file).

# Password of the bundled Redis (required). Use letters and digits only: it is placed into a redis:// URL.
# Generate one, for example:  openssl rand -hex 24
REDIS_PASSWORD=change-me

# Where the published ports bind on the host. Loopback by default. To serve the gRPC port to the network, enable
# [tls] in config.docker.toml first and then set VULTURE_GRPC_BIND=0.0.0.0 (see deploy/README.md).
VULTURE_GRPC_BIND=127.0.0.1
VULTURE_GRPC_PORT=50051
# The metrics endpoint is unauthenticated: keep it on loopback or an internal network.
VULTURE_METRICS_BIND=127.0.0.1
VULTURE_METRICS_PORT=9100

# Host directory bind-mounted at /var/lib/vulture. It holds the access token (`token`), `state.json` and
# `audit.log`. Read the token with `cat data/token`; change it by editing the file. Create the directory before
# the first `up` (see deploy/README.md), otherwise Docker creates it owned by root.
VULTURE_DATA_DIR=./data
# The user the container runs as. 65532 is the image's "nonroot" user. To read and edit data/token without sudo,
# set your own ids (`id -u`, `id -g`) and make the TLS files readable by them too: pass the same pair as
# VULTURE_TLS_OWNER=<uid>:<gid> to deploy/certbot/vulture-deploy-hook.sh.
VULTURE_UID=65532
VULTURE_GID=65532

# Host directory with the TLS files, mounted read-only at /etc/vulture/tls (used when [tls] is enabled). It must
# be readable by VULTURE_UID:VULTURE_GID; deploy/certbot/vulture-deploy-hook.sh maintains it.
VULTURE_TLS_DIR=./tls

# Configuration file mounted at /etc/vulture/config.toml. The default is ./config.docker.toml (and
# ./config.docker.tls.toml with docker-compose.tls.yml). To enable more exchanges without editing a tracked file,
# copy it to an untracked name matching deploy/config.local*.toml, edit the copy and point this variable at it. The
# path is relative to the deploy directory.
#VULTURE_CONFIG_FILE=./config.local.toml

# Image tag used by `docker compose build` / `up`.
VULTURE_IMAGE=vulture-server:local

# History in ClickHouse (optional, see deploy/README.md and deploy/clickhouse/BACKUP.md). To turn it on:
#   COMPOSE_PROFILES=clickhouse
#   VULTURE_CLICKHOUSE_ENABLED=true
# CLICKHOUSE_PASSWORD is required by the compose file even while the profile is off; the server reads it from the
# environment. If the value could be read as a number or true/false (for example only digits), wrap it in double
# quotes, otherwise the environment override parses it as a number. Generate one:  openssl rand -hex 24
CLICKHOUSE_PASSWORD=change-me-too
# Password of the read-only analysis user `reader` of the bundled ClickHouse (clickhouse/users.d/reader.xml; DBeaver,
# clickhouse-client, Grafana, `vulture-server analyze`). Required by the compose file like CLICKHOUSE_PASSWORD. Use a
# different value from CLICKHOUSE_PASSWORD. Generate one:  openssl rand -hex 24
CLICKHOUSE_READER_PASSWORD=change-me-three
#COMPOSE_PROFILES=clickhouse
VULTURE_CLICKHOUSE_ENABLED=false
