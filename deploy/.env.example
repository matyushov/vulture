# Template for deploy/.env (copy it: `cp .env.example .env`). The real .env is ignored by git; never commit it.
# Compose reads it for interpolation: `docker compose --env-file .env up -d` (or keep it next to the compose file).

# Password of the bundled Redis (required). Use letters and digits only: it is placed into a redis:// URL.
# Generate one, for example:  openssl rand -hex 24
REDIS_PASSWORD=change-me

# Where the published ports bind on the host. Loopback by default. To serve the gRPC port to the network, enable
# [tls] in config.docker.toml first and then set VULTURE_GRPC_BIND=0.0.0.0 (see deploy/README.md).
VULTURE_GRPC_BIND=127.0.0.1
VULTURE_GRPC_PORT=50051
# The metrics endpoint is unauthenticated: keep it on loopback or an internal network.
VULTURE_METRICS_BIND=127.0.0.1
VULTURE_METRICS_PORT=9100

# Host directory with the TLS files, mounted read-only at /etc/vulture/tls (used when [tls] is enabled). It must
# be readable by uid 65532 (the container user); deploy/certbot/vulture-deploy-hook.sh maintains it.
VULTURE_TLS_DIR=./tls

# Image tag used by `docker compose build` / `up`.
VULTURE_IMAGE=vulture-server:local

# History in ClickHouse (optional, see deploy/README.md and deploy/clickhouse/BACKUP.md). To turn it on:
#   COMPOSE_PROFILES=clickhouse
#   VULTURE_CLICKHOUSE_ENABLED=true
# CLICKHOUSE_PASSWORD is required by the compose file even while the profile is off; the server reads it from the
# environment. If the value could be read as a number or true/false (for example only digits), wrap it in double
# quotes, otherwise the environment override parses it as a number. Generate one:  openssl rand -hex 24
CLICKHOUSE_PASSWORD=change-me-too
#COMPOSE_PROFILES=clickhouse
VULTURE_CLICKHOUSE_ENABLED=false
